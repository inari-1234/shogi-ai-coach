  "policy": {
    "HIGH": {
      "tone": "ASSERTIVE",
      "directCausalWording": "only when ClaimConfidenceAssessment.eligibleForCausalWording is true",
      "scoreGapAsReason": false
    },
    "MEDIUM": {
      "tone": "MEASURED",
      "directCausalWording": false,
