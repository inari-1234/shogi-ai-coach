    },
    "LOW": {
      "tone": "TENTATIVE",
      "directCausalWording": false,
      "requiredCaveat": "only factual difference may be stated"
    },
    "UNRESOLVED": {
      "tone": "UNRESOLVED",
      "directCausalWording": false,
      "behavior": "safe abstention",
      "requiredTextMeaning": "ranking or evaluation alone does not safely explain why one candidate is better"
    }
  },
  "sequenceWording": {
    "pvIsObservationNotForcedProof": true,
    "futureTextRequiresStableAuthorizedHorizon": true,
